На сервері потрібно зробити одне правило:
щоб при оновленні не на основній сторінці тебе не вибивало бо в нас одна головна сторінка контент на якій змінюється функцією а не зміною сторінки

Якщо користувач запитує будь-який URL (навіть /about, /contacts тощо),
— все одно віддавати main.html.
front++
приклад


// server.js
const http = require("http");
const fs = require("fs");
const path = require("path");

const PORT = 3000;
const PUBLIC_DIR = path.join(__dirname, "public");

const server = http.createServer((req, res) => {
  let filePath = path.join(PUBLIC_DIR, req.url === "/" ? "main.html" : req.url);
  const ext = path.extname(filePath);

  fs.stat(filePath, (err, stats) => {
    if (!err && stats.isFile()) {
      serveFile(filePath, ext, res);
    } else {
      // якщо файлу немає — все одно віддаємо main.html
      serveFile(path.join(PUBLIC_DIR, "main.html"), ".html", res);
    }
  });
});

function serveFile(filePath, ext, res) {
  const contentType = {
    ".html": "text/html",
    ".css": "text/css",
    ".js": "application/javascript",
    ".png": "image/png",
    ".jpg": "image/jpeg"
  }[ext] || "text/plain";

  fs.readFile(filePath, (err, content) => {
    if (err) {
      res.writeHead(500);
      res.end("Server error");
    } else {
      res.writeHead(200, { "Content-Type": contentType });
      res.end(content);
    }
  });
}

server.listen(PORT, () => console.log(`Server running at http://localhost:${PORT}`));
